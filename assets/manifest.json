{
    "manifest_version": 3,
    "name": "PniPinP",
    "version": "0.0.0",

    "description": "__MSG_extensionDescription__",

    "permissions": ["activeTab", "scripting", "storage"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "__MSG_actionDefaultTitle__"
    },
    "web_accessible_resources": [
        {
            "resources": ["*.map"],
            "matches": ["<all_urls>"]
        }
    ],
    "options_page": "./options.html",
    "default_locale": "ja"
}